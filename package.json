{
  "name": "netease-music-analyze",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js",
    "check": "tsx --test checks/*.test.ts"
  },
  "dependencies": {
    "@neteasecloudmusicapienhanced/api": "4.41.1",
    "echarts": "6.1.0",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "lucide-react": "1.67.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "10.0.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
